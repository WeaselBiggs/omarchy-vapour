#!/usr/bin/env python3
"""Look up HowLongToBeat lengths for the games in the playtime record.

HowLongToBeat has no official API. This talks to the same endpoint the site's
own search box uses, found the way the community `howlongtobeatpy` library
finds it: read the homepage, scan its JS chunks for the POST fetch, ask the
endpoint's /init for a token, then search. Any of that can break when the site
changes; when it does, the cache keeps whatever it already knows and the panel
says "unavailable" instead of failing.

Results are cached per Steam app in $XDG_CACHE_HOME/omarchy/steam/hltb/ and
only a few stale entries are refreshed per run, so a big library trickles in
over several refreshes instead of hammering the site. When anything changed,
the playtime record is regenerated by running `collect --no-hltb`.

Usage: hltb [--max N] [--force] [--verbose]
"""

import argparse
import datetime as dt
import difflib
import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

HOME = os.path.expanduser("~")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME") or f"{HOME}/.local/state", "omarchy", "steam")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or f"{HOME}/.cache", "omarchy", "steam", "hltb")
RECORD_PATH = os.path.join(STATE_DIR, "playtime.json")
SESSION_PATH = os.path.join(CACHE_DIR, "session.json")
LOCK_PATH = os.path.join(CACHE_DIR, ".lock")
COLLECT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "collect")

BASE_URL = "https://howlongtobeat.com/"
USER_AGENT = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0 Safari/537.36"
HEADERS = {"User-Agent": USER_AGENT, "Referer": BASE_URL, "Origin": BASE_URL.rstrip("/"), "Accept": "*/*"}

# How long each kind of answer stays good for.
TTL = {"ok": 30 * 86400, "nodata": 7 * 86400, "missing": 7 * 86400, "error": 6 * 3600}
SESSION_TTL = 12 * 3600
PAUSE_BETWEEN_SEARCHES = 1.5
MATCH_THRESHOLD = 0.86

VERBOSE = False


def log(message):
    if VERBOSE:
        print(f"hltb: {message}", file=sys.stderr)


# ------------------------------------------------------------------ http

def http_get(url, timeout=20):
    req = urllib.request.Request(url, headers=HEADERS)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read().decode("utf-8", "replace")


def http_post_json(url, payload, extra_headers, timeout=20):
    headers = dict(HEADERS, **{"Content-Type": "application/json"}, **extra_headers)
    req = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"), headers=headers, method="POST")
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8", "replace"))


# --------------------------------------------------------------- session

_FETCH_PATTERN = re.compile(
    r'fetch\s*\(\s*["\']/api/([a-zA-Z0-9_/]+)[^"\']*["\']\s*,\s*{[^}]*method:\s*["\']POST["\'][^}]*}',
    re.S | re.I,
)


def discover_search_path():
    """The site's search endpoint moves; find the one its own JS POSTs to."""
    home = http_get(BASE_URL)
    scripts = sorted(set(re.findall(r'src="(/_next/static/chunks/[^"]+)"', home)))
    for script in scripts:
        try:
            js = http_get(BASE_URL.rstrip("/") + script)
        except (urllib.error.URLError, OSError):
            continue
        match = _FETCH_PATTERN.search(js)
        if match:
            return "/api/" + match.group(1).rstrip("/")
    raise RuntimeError("could not find the search endpoint in the site's scripts")


def fetch_token(search_path):
    data = json.loads(http_get(f"{BASE_URL.rstrip('/')}{search_path}/init?t={int(time.time() * 1000)}"))
    token = data.get("token")
    key = value = None
    for name, val in data.items():
        lower = name.lower()
        if "key" in lower:
            key = val
        elif "val" in lower:
            value = val
    if not token:
        raise RuntimeError("init response carried no token")
    return {"token": str(token), "key": key, "value": value}


def load_session():
    try:
        with open(SESSION_PATH, encoding="utf-8") as f:
            session = json.load(f)
        if time.time() - float(session.get("fetchedAt", 0)) < SESSION_TTL and session.get("searchPath"):
            return session
    except (OSError, ValueError):
        pass
    return None


def new_session():
    search_path = discover_search_path()
    session = {"searchPath": search_path, "fetchedAt": time.time(), **fetch_token(search_path)}
    write_json_atomic(SESSION_PATH, session)
    log(f"new session via {search_path}")
    return session


# ---------------------------------------------------------------- search

def search_terms(name, plain=False):
    """The site's search box does not strip trademark marks, so "Company\u2122"
    finds nothing while "Company" finds the game. `plain` goes further and
    drops every symbol, the fallback for a title the first query misses."""
    text = re.sub(r"[\u2122\u00ae\u00a9]", "", str(name or ""))
    if plain:
        text = re.sub(r"[^A-Za-z0-9 ]+", " ", text)
    return text.split()


def search_payload(name, session, plain=False):
    payload = {
        "searchType": "games",
        "searchTerms": search_terms(name, plain),
        "searchPage": 1,
        "size": 20,
        "searchOptions": {
            "games": {
                "userId": 0, "platform": "", "sortCategory": "popular", "rangeCategory": "main",
                "rangeTime": {"min": 0, "max": 0},
                "gameplay": {"perspective": "", "flow": "", "genre": "", "difficulty": ""},
                "rangeYear": {"max": "", "min": ""}, "modifier": "",
            },
            "users": {"sortCategory": "postcount"},
            "lists": {"sortCategory": "follows"},
            "filter": "", "sort": 0, "randomizer": 0,
        },
        "useCache": True,
    }
    if session.get("key"):
        payload[session["key"]] = session["value"]
    return payload


def search(name, session):
    headers = {"x-auth-token": session["token"], "x-hp-key": str(session.get("key")), "x-hp-val": str(session.get("value"))}
    url = BASE_URL.rstrip("/") + session["searchPath"]
    results = http_post_json(url, search_payload(name, session), headers).get("data") or []
    if not results and search_terms(name, plain=True) != search_terms(name):
        time.sleep(PAUSE_BETWEEN_SEARCHES)
        results = http_post_json(url, search_payload(name, session, plain=True), headers).get("data") or []
    return results


# -------------------------------------------------------------- matching

def normalize(name):
    text = str(name or "").lower()
    text = re.sub(r"[™®©]", "", text)
    text = re.sub(r"\s*[:\-–—]\s*", " ", text)
    text = re.sub(r"[^a-z0-9 ]+", " ", text)
    text = re.sub(r"\b(the|a|an)\b", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def best_match(name, results):
    """Exact title first, then the closest full-game title above the threshold."""
    wanted = normalize(name)
    games = [r for r in results if str(r.get("game_type") or "game") == "game"]
    for r in games:
        if normalize(r.get("game_name")) == wanted or normalize(r.get("game_alias")) == wanted:
            return r
    best, best_score = None, 0.0
    for r in games:
        score = difflib.SequenceMatcher(None, wanted, normalize(r.get("game_name"))).ratio()
        if score > best_score:
            best, best_score = r, score
    return best if best_score >= MATCH_THRESHOLD else None


def hours(seconds):
    value = float(seconds or 0)
    return round(value / 3600, 1) if value > 0 else None


def entry_from_result(app_id, name, result):
    main, extra, completionist = hours(result.get("comp_main")), hours(result.get("comp_plus")), hours(result.get("comp_100"))
    all_styles = hours(result.get("comp_all"))
    entry = {
        "appId": int(app_id),
        "steamName": name,
        "hltbId": int(result.get("game_id") or 0),
        "hltbName": str(result.get("game_name") or ""),
        "url": f"{BASE_URL}game/{int(result.get('game_id') or 0)}",
        "main": main,
        "extra": extra,
        "completionist": completionist,
        "allStyles": all_styles,
        "fetchedAt": int(time.time()),
    }
    entry["status"] = "ok" if any(v for v in (main, extra, completionist, all_styles)) else "nodata"
    return entry


# ----------------------------------------------------------------- cache

def cache_path(app_id):
    return os.path.join(CACHE_DIR, f"{int(app_id)}.json")


def load_cached(app_id):
    try:
        with open(cache_path(app_id), encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def is_stale(entry):
    if not entry:
        return True
    ttl = TTL.get(str(entry.get("status")), TTL["error"])
    return time.time() - float(entry.get("fetchedAt") or 0) > ttl


def write_json_atomic(path, payload):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(payload, f, indent=2, sort_keys=True)
        f.write("\n")
    os.replace(tmp, path)


# ------------------------------------------------------------------ main

def main():
    global VERBOSE
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--max", type=int, default=8, help="stale entries to refresh this run")
    parser.add_argument("--force", action="store_true", help="refresh every game regardless of age")
    parser.add_argument("--verbose", action="store_true")
    args = parser.parse_args()
    VERBOSE = args.verbose

    try:
        with open(RECORD_PATH, encoding="utf-8") as f:
            games = (json.load(f) or {}).get("games") or []
    except (OSError, ValueError):
        log("no playtime record yet")
        return 0

    os.makedirs(CACHE_DIR, exist_ok=True)
    lock = open(LOCK_PATH, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        log("another lookup is running")
        return 0

    pending = []
    for game in games:
        app_id, name = game.get("appId"), str(game.get("name") or "")
        if not app_id or not name:
            continue
        if args.force or is_stale(load_cached(app_id)):
            pending.append((int(app_id), name))
    if not pending:
        log("cache is fresh")
        return 0
    pending = pending[: max(1, args.max)]

    session = load_session()
    changed = False
    try:
        if session is None:
            session = new_session()
    except Exception as exc:  # site changed or unreachable: mark and bow out
        print(f"hltb: could not open a session: {exc}", file=sys.stderr)
        for app_id, name in pending:
            write_json_atomic(cache_path(app_id), {"appId": app_id, "steamName": name, "status": "error", "fetchedAt": int(time.time()), "error": str(exc)})
        changed = True
        session = None

    for index, (app_id, name) in enumerate(pending if session else []):
        if index:
            time.sleep(PAUSE_BETWEEN_SEARCHES)
        try:
            try:
                results = search(name, session)
            except urllib.error.HTTPError as exc:
                if exc.code != 403:
                    raise
                # The site's own code refreshes the token on 403 and retries once.
                session = new_session()
                results = search(name, session)
            match = best_match(name, results)
            if match is None:
                entry = {"appId": app_id, "steamName": name, "status": "missing", "fetchedAt": int(time.time()),
                         "candidates": [str(r.get("game_name") or "") for r in results[:3]]}
                log(f"{name}: no match among {len(results)} results")
            else:
                entry = entry_from_result(app_id, name, match)
                log(f"{name}: {entry['hltbName']} main={entry['main']} extra={entry['extra']} 100={entry['completionist']}")
        except Exception as exc:
            entry = {"appId": app_id, "steamName": name, "status": "error", "fetchedAt": int(time.time()), "error": str(exc)}
            print(f"hltb: lookup failed for {name}: {exc}", file=sys.stderr)
        write_json_atomic(cache_path(app_id), entry)
        changed = True

    if changed and os.access(COLLECT, os.X_OK):
        subprocess.run([COLLECT, "--no-hltb-spawn"] + record_args(), check=False)
    return 0


def record_args():
    """Reuse the week mode and threshold the last collect ran with, so the
    regenerated record matches what the panel asked for."""
    try:
        with open(RECORD_PATH, encoding="utf-8") as f:
            record = json.load(f) or {}
    except (OSError, ValueError):
        return []
    out = ["--week-mode", "monday" if record.get("weekMode") == "monday" else "rolling"]
    if record.get("minMinutes") is not None:
        out += ["--min-minutes", str(int(record["minMinutes"]))]
    if record.get("lookupNames") is False:
        out.append("--no-names")
    if record.get("hltbEnabled") is False:
        out.append("--no-hltb")
    return out


if __name__ == "__main__":
    sys.exit(main())
