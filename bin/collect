#!/usr/bin/env python3
"""Collect playtime from every store into one display-ready JSON record.

Steam keeps its own figures: all-time minutes and a rolling two-week total per
game in localconfig.vdf. "This week" is derived from daily snapshots of the
all-time figure that this script keeps under the state directory; until seven
days of snapshots exist the two-week total stands in and the record says so.

Every other store (Battle.net first, anything else through games.json) keeps
no playtime on disk, so Vapour is the stopwatch: Main.qml times the game's
window and bin/sessions writes the sessions ledger. Those games get their week,
day, two-week and total figures straight from the ledger.

Writes:
  $XDG_STATE_HOME/omarchy/vapour/playtime.json            the record Panel.qml reads
  $XDG_STATE_HOME/omarchy/vapour/snapshots/YYYY-MM-DD.json  {appid: totalMinutes}
  $XDG_CACHE_HOME/omarchy/vapour/apps/<appid>.json          Steam name + header image

Reads:
  $XDG_STATE_HOME/omarchy/vapour/sessions.json            the ledger bin/sessions keeps
  $XDG_CONFIG_HOME/omarchy/vapour/games.json              watched games and store settings
  $XDG_CONFIG_HOME/omarchy/vapour/hltb-overrides.json     hand-maintained lengths

HowLongToBeat lengths are read from the cache that bin/hltb maintains (or from
the overrides file, which wins). When any game still needs a lookup, bin/hltb
is started in the background after the record is written; it regenerates the
record itself once it has answers.

Usage: collect [--week-mode rolling|monday] [--min-minutes N] [--no-names] [--no-hltb] [--no-hltb-spawn]
"""

import argparse
import datetime as dt
import glob
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request

HOME = os.path.expanduser("~")
XDG_STATE = os.environ.get("XDG_STATE_HOME") or f"{HOME}/.local/state"
XDG_CACHE = os.environ.get("XDG_CACHE_HOME") or f"{HOME}/.cache"
XDG_CONFIG = os.environ.get("XDG_CONFIG_HOME") or f"{HOME}/.config"
STATE_DIR = os.path.join(XDG_STATE, "omarchy", "vapour")
CACHE_DIR = os.path.join(XDG_CACHE, "omarchy", "vapour")
CONFIG_DIR = os.path.join(XDG_CONFIG, "omarchy", "vapour")
SNAPSHOT_DIR = os.path.join(STATE_DIR, "snapshots")
APPS_CACHE_DIR = os.path.join(CACHE_DIR, "apps")
HLTB_CACHE_DIR = os.path.join(CACHE_DIR, "hltb")
BIN_DIR = os.path.dirname(os.path.abspath(__file__))
HLTB_SCRIPT = os.path.join(BIN_DIR, "hltb")
RECORD_PATH = os.path.join(STATE_DIR, "playtime.json")
SESSIONS_PATH = os.path.join(STATE_DIR, "sessions.json")
GAMES_CONFIG_PATH = os.path.join(CONFIG_DIR, "games.json")

SNAPSHOT_KEEP_DAYS = 35
NAME_RETRY_SECONDS = 24 * 3600
STORE_API = "https://store.steampowered.com/api/appdetails?appids={appid}&filters=basic"

# Where `omarchy-install-gaming-battlenet` puts the client.
BNET_DEFAULT_PREFIX = os.path.join(HOME, "Games", "battlenet")
BNET_LAUNCHER = "drive_c/Program Files (x86)/Battle.net/Battle.net Launcher.exe"

# Battle.net product code (as it appears in Battle.net.config) -> display name,
# install folder under Program Files (x86), the executables whose window means
# the game is up, and the code `Battle.net Launcher.exe --exec="launch X"` takes.
BNET_PRODUCTS = {
    "fenris": ("Diablo IV", "Diablo IV", ["Diablo IV.exe"], "Fen"),
    "osi": ("Diablo II: Resurrected", "Diablo II Resurrected", ["D2R.exe"], "OSI"),
