    "anbs": ("Diablo Immortal", "Diablo Immortal", ["DiabloImmortal.exe"], "ANBS"),
    "pro": ("Overwatch 2", "Overwatch", ["Overwatch.exe"], "Pro"),
    "wow": ("World of Warcraft", "World of Warcraft", ["Wow.exe", "WowT.exe"], "WoW"),
    "wow_classic": ("World of Warcraft Classic", "World of Warcraft", ["WowClassic.exe", "WowClassicT.exe"], "WoWC"),
    "wow_classic_era": ("World of Warcraft Classic Era", "World of Warcraft", ["WowClassic.exe"], "WoWClassicEra"),
    "s2": ("StarCraft II", "StarCraft II", ["SC2_x64.exe", "SC2.exe"], "S2"),
    "s1": ("StarCraft", "StarCraft", ["StarCraft.exe"], "S1"),
    "w3": ("Warcraft III", "Warcraft III", ["Warcraft III.exe"], "W3"),
    "hero": ("Heroes of the Storm", "Heroes of the Storm", ["HeroesOfTheStorm_x64.exe", "HeroesOfTheStorm.exe"], "Hero"),
