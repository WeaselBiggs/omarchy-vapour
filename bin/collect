}
BNET_NOT_GAMES = {"battle_net", "agent", "bna", "bts", "catalogs", "clnt"}


# ------------------------------------------------------------------ vdf

_TOKEN = re.compile(r'"((?:[^"\\]|\\.)*)"|([{}])|(//[^\n]*)|(\S+)')


def parse_vdf(text):
    """Text VDF (KeyValues) to nested dicts. Duplicate keys keep the last value."""
    root = {}
    stack = [root]
    key = None
    for match in _TOKEN.finditer(text):
        quoted, brace, comment, bare = match.groups()
        if comment is not None:
            continue
        if brace == "{":
            child = {}
            stack[-1][key] = child
            stack.append(child)
            key = None
        elif brace == "}":
            if len(stack) > 1:
                stack.pop()
            key = None
        else:
            token = quoted.replace('\\"', '"').replace("\\\\", "\\") if quoted is not None else bare
            if key is None:
                key = token
            else:
                stack[-1][key] = token
                key = None
    return root


def walk(node, *path):
    """Case-insensitive descent; Steam is inconsistent about key casing."""
    for part in path:
        if not isinstance(node, dict):
            return None
        found = None
        for k, v in node.items():
            if k.lower() == part.lower():
                found = v
                break
        if found is None:
            return None
        node = found
    return node


# ---------------------------------------------------------------- steam

def steam_root():
    for candidate in (f"{HOME}/.local/share/Steam", f"{HOME}/.steam/steam", f"{HOME}/.var/app/com.valvesoftware.Steam/.local/share/Steam"):
        if os.path.isdir(os.path.join(candidate, "userdata")):
            return candidate
    return None


def most_recent_user(root):
    """SteamID3 (the userdata folder name) of the most recently signed-in account."""
    try:
        with open(os.path.join(root, "config", "loginusers.vdf"), encoding="utf-8", errors="replace") as f:
            users = walk(parse_vdf(f.read()), "users") or {}
    except OSError:
        users = {}
    chosen = None
    for steamid64, info in users.items():
        if isinstance(info, dict) and str(info.get("MostRecent", info.get("mostrecent", "0"))) == "1":
            chosen = steamid64
    if chosen is None and users:
        chosen = next(iter(users))
    if chosen is not None:
        return str(int(chosen) - 76561197960265728)
    dirs = [d for d in os.listdir(os.path.join(root, "userdata")) if d.isdigit() and d != "0"]
    return dirs[0] if dirs else None


def read_playtimes(root, user):
    path = os.path.join(root, "userdata", user, "config", "localconfig.vdf")
    with open(path, encoding="utf-8", errors="replace") as f:
        data = parse_vdf(f.read())
    apps = walk(data, "UserLocalConfigStore", "Software", "Valve", "Steam", "apps") or {}
    result = {}
    for appid, entry in apps.items():
        if not appid.isdigit() or not isinstance(entry, dict):
            continue
        total = walk(entry, "Playtime")
        if total is None:
            continue
        result[appid] = {
            "total": int(total or 0),
            "twoWeeks": int(walk(entry, "Playtime2wks") or 0),
            "lastPlayed": int(walk(entry, "LastPlayed") or 0),
        }
    return result


def library_manifests(root):
    """appid -> name for every installed game across all library folders."""
    folders = [root]
    try:
        with open(os.path.join(root, "steamapps", "libraryfolders.vdf"), encoding="utf-8", errors="replace") as f:
            lib = walk(parse_vdf(f.read()), "libraryfolders") or {}
        for entry in lib.values():
            if isinstance(entry, dict) and entry.get("path"):
                folders.append(entry["path"])
    except OSError:
        pass
    names = {}
    for folder in dict.fromkeys(folders):
        steamapps = os.path.join(folder, "steamapps")
        try:
            files = os.listdir(steamapps)
        except OSError:
            continue
        for name in files:
            m = re.match(r"appmanifest_(\d+)\.acf$", name)
            if not m:
                continue
            try:
                with open(os.path.join(steamapps, name), encoding="utf-8", errors="replace") as f:
                    state = walk(parse_vdf(f.read()), "AppState") or {}
                names[m.group(1)] = str(state.get("name") or "")
            except OSError:
                continue
    return names


# ------------------------------------------------------------ snapshots

def today():
    return dt.date.today()


def snapshot_path(day):
    return os.path.join(SNAPSHOT_DIR, f"{day.isoformat()}.json")


def load_snapshot(day):
    try:
        with open(snapshot_path(day), encoding="utf-8") as f:
            data = json.load(f)
        return {k: int(v) for k, v in data.items()} if isinstance(data, dict) else None
    except (OSError, ValueError):
        return None


def write_json_atomic(path, payload):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(payload, f, indent=2, sort_keys=True)
        f.write("\n")
    os.replace(tmp, path)


def prune_snapshots(now):
    try:
        files = os.listdir(SNAPSHOT_DIR)
    except OSError:
        return
    for name in files:
        m = re.match(r"(\d{4}-\d{2}-\d{2})\.json$", name)
        if not m:
            continue
        try:
            day = dt.date.fromisoformat(m.group(1))
        except ValueError:
            continue
        if (now - day).days > SNAPSHOT_KEEP_DAYS:
            try:
                os.remove(os.path.join(SNAPSHOT_DIR, name))
            except OSError:
                pass


def week_baseline(now, mode):
    """The snapshot that "this week" is measured against, and the date it ideally would be."""
    if mode == "monday":
        target = now - dt.timedelta(days=now.weekday() + 1)  # end of last Sunday
    else:
        target = now - dt.timedelta(days=7)
    day = target
    while day < now:
        snap = load_snapshot(day)
        if snap is not None:
            return day, snap, target
        day += dt.timedelta(days=1)
    return None, None, target


def steam_day_series(now, current):
    """Steam minutes per calendar day for the last seven days; None where history is missing."""
    series = []
    for offset in range(6, -1, -1):
        day = now - dt.timedelta(days=offset)
        prev = load_snapshot(day - dt.timedelta(days=1))
        this = current if offset == 0 else load_snapshot(day)
        minutes = None
        if prev is not None and this is not None:
            minutes = sum(max(0, this.get(a, 0) - prev.get(a, 0)) for a in this)
        series.append({"date": day.isoformat(), "minutes": minutes})
    return series


# -------------------------------------------------------------- sessions

def load_sessions():
    """The ledger bin/sessions keeps: closed sessions plus the ones open now."""
    try:
        with open(SESSIONS_PATH, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    spans = {}
    for entry in data.get("sessions") or []:
        try:
            start, end = float(entry["start"]), float(entry["end"])
        except (KeyError, TypeError, ValueError):
            continue
        if end > start:
            spans.setdefault(str(entry.get("id")), []).append((start, end))
    for game_id, entry in (data.get("open") or {}).items():
        try:
            start, seen = float(entry["start"]), float(entry["seen"])
        except (KeyError, TypeError, ValueError):
            continue
        if seen > start:
            spans.setdefault(str(game_id), []).append((start, seen))
    return spans


def overlap_minutes(spans, lo, hi):
    seconds = 0.0
    for start, end in spans:
        seconds += max(0.0, min(end, hi) - max(start, lo))
    return int(round(seconds / 60))


def sessions_day_series(now, spans_by_id):
    all_spans = [span for spans in spans_by_id.values() for span in spans]
    series = []
    for offset in range(6, -1, -1):
        day = now - dt.timedelta(days=offset)
        lo = dt.datetime.combine(day, dt.time.min).astimezone().timestamp()
        hi = lo + 86400
        minutes = overlap_minutes(all_spans, lo, hi)
        series.append({"date": day.isoformat(), "minutes": minutes if minutes > 0 else None})
    return series


def merge_day_series(steam_days, session_days):
    merged = []
    for s, o in zip(steam_days, session_days):
        if s["minutes"] is None and o["minutes"] is None:
            minutes = None
        else:
            minutes = int(s["minutes"] or 0) + int(o["minutes"] or 0)
        merged.append({"date": s["date"], "minutes": minutes})
    return merged


def week_window(now_dt, mode):
    """(start, end) timestamps for "this week" as the sessions ledger sees it."""
    if mode == "monday":
        monday = (now_dt - dt.timedelta(days=now_dt.weekday())).replace(hour=0, minute=0, second=0, microsecond=0)
        return monday.timestamp(), now_dt.timestamp()
    return now_dt.timestamp() - 7 * 86400, now_dt.timestamp()


# --------------------------------------------------------- watched games

def load_games_config():
    try:
        with open(GAMES_CONFIG_PATH, encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def uwsm(argv):
    return "uwsm-app -- " + " ".join(shlex.quote(a) for a in argv)


def bnet_play_command(prefix, launch_code, template):
    launcher = os.path.join(prefix, BNET_LAUNCHER)
    if template:
        return str(template).replace("{code}", launch_code).replace("{prefix}", shlex.quote(prefix)).replace("{launcher}", shlex.quote(launcher))
    return uwsm(["env", f"WINEPREFIX={prefix}", "PROTONPATH=GE-Proton", "GAMEID=umu-battlenet", "PROTON_VERB=run",
                 "umu-run", launcher, f'--exec=launch {launch_code}'])


def discover_battlenet(config):
    """Installed Blizzard products, from the client's own config in the prefix."""
    settings = config.get("battlenet")
    if settings is False or settings is None and "battlenet" in config:
        return [], None
    settings = settings if isinstance(settings, dict) else {}
    prefix = os.path.expanduser(str(settings.get("prefix") or BNET_DEFAULT_PREFIX))
    if not os.path.isfile(os.path.join(prefix, BNET_LAUNCHER)):
        return [], None
    codes = {}
    for path in glob.glob(os.path.join(prefix, "drive_c", "users", "*", "AppData", "Roaming", "Battle.net", "Battle.net.config")):
        try:
            with open(path, encoding="utf-8") as f:
                data = json.load(f)
        except (OSError, ValueError):
            continue
        for code, entry in (data.get("Games") or {}).items():
            if isinstance(entry, dict):
                codes[code.lower()] = entry
    program_files = os.path.join(prefix, "drive_c", "Program Files (x86)")
    games = []
    for code, entry in codes.items():
        if code in BNET_NOT_GAMES or code not in BNET_PRODUCTS:
            continue
        name, folder, exes, launch_code = BNET_PRODUCTS[code]
        games.append({
            "id": f"bnet:{code}",
            "store": "Battle.net",
            "name": name,
            "classes": [exe.lower() for exe in exes],
            "installed": os.path.isdir(os.path.join(program_files, folder)),
            "lastPlayedHint": int(entry.get("LastPlayed") or 0),
            "play": bnet_play_command(prefix, launch_code, settings.get("play")),
        })
    return games, prefix


def watched_games(config):
    """Every game Vapour times itself: discovered Battle.net products, then the
    entries in games.json (which can also override a discovered one by id)."""
    games, _ = discover_battlenet(config)
    by_id = {g["id"]: g for g in games}
    for entry in config.get("games") or []:
        if not isinstance(entry, dict) or not entry.get("id"):
            continue
        game_id = str(entry["id"])
        base = by_id.get(game_id) or {"id": game_id, "store": "Other", "name": game_id, "classes": [], "installed": None, "play": None}
        if entry.get("name"):
            base["name"] = str(entry["name"])
        if entry.get("store"):
            base["store"] = str(entry["store"])
        if isinstance(entry.get("classes"), list):
            base["classes"] = [str(c).lower() for c in entry["classes"]]
        if entry.get("play") is not None:
            base["play"] = str(entry["play"]) or None
        if entry.get("installed") is not None:
            base["installed"] = bool(entry["installed"])
        if entry.get("hidden"):
            by_id.pop(game_id, None)
            continue
        by_id[game_id] = base
    return list(by_id.values())


# ---------------------------------------------------------------- names

def cached_app(appid):
    try:
        with open(os.path.join(APPS_CACHE_DIR, f"{appid}.json"), encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def fetch_app(appid):
    """Keyless store lookup. Failures are cached for a day so a dead entry is not retried every run."""
    payload = {"name": None, "headerImage": None, "fetchedAt": int(time.time())}
    try:
        req = urllib.request.Request(STORE_API.format(appid=appid), headers={"User-Agent": "omarchy-vapour"})
        with urllib.request.urlopen(req, timeout=8) as resp:
            body = json.load(resp)
        entry = body.get(str(appid)) or {}
        if entry.get("success") and isinstance(entry.get("data"), dict):
            payload["name"] = entry["data"].get("name")
            payload["headerImage"] = entry["data"].get("header_image")
    except Exception as exc:  # network, JSON, rate limit — all just "no name yet"
        print(f"collect: store lookup failed for {appid}: {exc}", file=sys.stderr)
    write_json_atomic(os.path.join(APPS_CACHE_DIR, f"{appid}.json"), payload)
    return payload


def resolve_app(appid, installed_names, allow_network):
    cached = cached_app(appid)
    if cached and cached.get("name"):
        return cached
    if installed_names.get(appid):
        return {"name": installed_names[appid], "headerImage": cached.get("headerImage") if cached else None}
    if not allow_network:
        return cached or {"name": None, "headerImage": None}
    if cached and time.time() - int(cached.get("fetchedAt") or 0) < NAME_RETRY_SECONDS:
        return cached
    return fetch_app(appid)


# ----------------------------------------------------------------- hltb

def hltb_cache_name(game_id):
    """Game id to a cache file name: "steam:123" -> steam-123.json."""
    return re.sub(r"[^A-Za-z0-9_.-]+", "-", str(game_id)) + ".json"


def hltb_overrides():
    """Hand-maintained lengths that beat whatever HowLongToBeat says:
    { "steam:1161580": { "main": 22.5, "extra": 31, "completionist": 48 } } in
    hours. A bare Steam app id ("1161580") still works."""
    try:
        with open(os.path.join(CONFIG_DIR, "hltb-overrides.json"), encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    return {(f"steam:{k}" if str(k).isdigit() else str(k)): v for k, v in data.items()}


def hltb_cached(game_id):
    try:
        with open(os.path.join(HLTB_CACHE_DIR, hltb_cache_name(game_id)), encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else None
    except (OSError, ValueError):
        return None


def hltb_for(game_id, overrides, enabled):
    """(hltb block or None, status). Status is one of override, ok, nodata,
    missing, error, pending, off — the panel words each of them."""
    override = overrides.get(game_id)
    if isinstance(override, dict):
        return {**{k: override.get(k) for k in ("main", "extra", "completionist")}, "source": "override"}, "override"
    if not enabled:
        return None, "off"
    cached = hltb_cached(game_id)
    if cached is None:
        return None, "pending"
    status = str(cached.get("status") or "error")
    if status != "ok":
        return None, status
    return {
        "main": cached.get("main"),
        "extra": cached.get("extra"),
        "completionist": cached.get("completionist"),
        "allStyles": cached.get("allStyles"),
        "name": cached.get("hltbName"),
        "url": cached.get("url"),
        "source": "hltb",
    }, "ok"


def spawn_hltb():
    """Fire the lookups off detached so the record lands now and the lengths
    arrive when they arrive. hltb exits at once when its cache is fresh."""
    if not os.access(HLTB_SCRIPT, os.X_OK):
        return
    try:
        subprocess.Popen([HLTB_SCRIPT], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
    except OSError as exc:
        print(f"collect: could not start hltb: {exc}", file=sys.stderr)


# ------------------------------------------------------------ migration

def migrate_from_steam_dirs():
    """Vapour used to live under omarchy/steam. Move whatever is still there,
    one item at a time so a half-moved layout (say, hltb ran first) heals too.
    HowLongToBeat cache files were named <appid>.json; they become steam-<appid>.json."""
    moves = [
        (os.path.join(XDG_STATE, "omarchy", "steam", "playtime.json"), RECORD_PATH),
        (os.path.join(XDG_STATE, "omarchy", "steam", "snapshots"), SNAPSHOT_DIR),
        (os.path.join(XDG_CACHE, "omarchy", "steam", "apps"), APPS_CACHE_DIR),
        (os.path.join(XDG_CACHE, "omarchy", "steam", "hltb"), HLTB_CACHE_DIR),
        (os.path.join(XDG_CONFIG, "omarchy", "steam", "hltb-overrides.json"), os.path.join(CONFIG_DIR, "hltb-overrides.json")),
    ]
    for old, new in moves:
        if not os.path.exists(old):
            continue
        try:
            if os.path.exists(new):
                if os.path.isdir(old) and os.path.isdir(new):
                    for name in os.listdir(old):
                        if not os.path.exists(os.path.join(new, name)):
                            shutil.move(os.path.join(old, name), os.path.join(new, name))
                    os.rmdir(old)
                else:
                    os.remove(old)
            else:
                os.makedirs(os.path.dirname(new), exist_ok=True)
                shutil.move(old, new)
        except OSError as exc:
            print(f"collect: could not migrate {old}: {exc}", file=sys.stderr)
    for base in (XDG_STATE, XDG_CACHE, XDG_CONFIG):
        old_dir = os.path.join(base, "omarchy", "steam")
        try:
            if os.path.isdir(old_dir) and not os.listdir(old_dir):
                os.rmdir(old_dir)
        except OSError:
            pass
    try:
        for name in os.listdir(HLTB_CACHE_DIR):
            m = re.match(r"(\d+)\.json$", name)
            if m and not os.path.exists(os.path.join(HLTB_CACHE_DIR, f"steam-{m.group(1)}.json")):
                os.replace(os.path.join(HLTB_CACHE_DIR, name), os.path.join(HLTB_CACHE_DIR, f"steam-{m.group(1)}.json"))
    except OSError:
        pass


# ----------------------------------------------------------------- main

def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--week-mode", choices=["rolling", "monday"], default="rolling")
    parser.add_argument("--min-minutes", type=int, default=5)
    parser.add_argument("--no-names", action="store_true", help="skip network lookups for game names")
    parser.add_argument("--no-hltb", action="store_true", help="do not read or refresh HowLongToBeat lengths")
    parser.add_argument("--no-hltb-spawn", action="store_true", help="read cached lengths but start no lookup (used by bin/hltb when it regenerates the record)")
    args = parser.parse_args()

    migrate_from_steam_dirs()

    now = today()
    now_dt = dt.datetime.now().astimezone()
    record = {
        "schemaVersion": 2,
        "updatedAt": now_dt.isoformat(timespec="seconds"),
        "updatedAtMs": int(time.time() * 1000),
        "weekMode": args.week_mode,
        "minMinutes": args.min_minutes,
        "lookupNames": not args.no_names,
        "hltbEnabled": not args.no_hltb,
        "error": "",
        "stores": [],
        "watch": [],
        "games": [],
        "days": [],
        "weekMinutes": 0,
        "weekSource": "none",
        "baselineDate": "",
        "historyDays": 0,
        "fullWeek": False,
    }
    overrides = hltb_overrides()
    games = []
    errors = []

    # ---- Steam: its own counters, week from snapshots
    steam_days = [{"date": (now - dt.timedelta(days=o)).isoformat(), "minutes": None} for o in range(6, -1, -1)]
    root = steam_root()
    user = most_recent_user(root) if root else None
    playtimes = None
    if root and user:
        try:
            playtimes = read_playtimes(root, user)
        except OSError as exc:
            errors.append(f"Could not read Steam playtime: {exc}")
    else:
        errors.append("No Steam installation found")

    if playtimes is not None:
        current = {appid: p["total"] for appid, p in playtimes.items()}
        write_json_atomic(snapshot_path(now), current)
        prune_snapshots(now)

        baseline_day, baseline, target = week_baseline(now, args.week_mode)
        if baseline is not None:
            record["weekSource"] = "snapshots"
            record["baselineDate"] = baseline_day.isoformat()
            record["historyDays"] = (now - baseline_day).days
            record["fullWeek"] = baseline_day <= target
        else:
            record["weekSource"] = "twoWeeks"

        installed = library_manifests(root)
        for appid, p in playtimes.items():
            if baseline is not None:
                week = max(0, p["total"] - baseline.get(appid, 0))
                if p["twoWeeks"]:
                    week = min(week, p["twoWeeks"])
            else:
                week = p["twoWeeks"]
            if week < args.min_minutes:
                continue
            app = resolve_app(appid, installed, not args.no_names)
            if not app.get("name"):
                continue  # non-Steam shortcuts and delisted apps have nothing to show
            game_id = f"steam:{appid}"
            hltb, hltb_status = hltb_for(game_id, overrides, not args.no_hltb)
            games.append({
                "id": game_id,
                "store": "Steam",
                "appId": int(appid),
                "name": app["name"],
                "headerImage": app.get("headerImage"),
                "weekMinutes": week,
                "twoWeekMinutes": p["twoWeeks"],
                "totalMinutes": p["total"],
                "lastPlayed": p["lastPlayed"],
                "installed": appid in installed,
                "play": uwsm(["steam", f"steam://rungameid/{int(appid)}"]),
                "hltb": hltb,
                "hltbStatus": hltb_status,
            })
        steam_days = steam_day_series(now, current)

    # ---- Everything else: timed by Main.qml, figures from the ledger
    config = load_games_config()
    watched = watched_games(config)
    record["watch"] = [{"id": g["id"], "classes": g["classes"]} for g in watched if g["classes"]]
    spans_by_id = load_sessions()
    week_lo, week_hi = week_window(now_dt, args.week_mode)
    for game in watched:
        spans = spans_by_id.get(game["id"], [])
        total = overlap_minutes(spans, 0, week_hi)
        week = overlap_minutes(spans, week_lo, week_hi)
        if week < args.min_minutes:
            continue
        last_played = int(max((end for _, end in spans), default=0)) or int(game.get("lastPlayedHint") or 0)
        hltb, hltb_status = hltb_for(game["id"], overrides, not args.no_hltb)
        games.append({
            "id": game["id"],
            "store": game["store"],
            "appId": 0,
            "name": game["name"],
            "headerImage": None,
            "weekMinutes": week,
            "twoWeekMinutes": overlap_minutes(spans, week_hi - 14 * 86400, week_hi),
            "totalMinutes": total,
            "lastPlayed": last_played,
            "installed": game.get("installed"),
            "play": game.get("play"),
            "hltb": hltb,
            "hltbStatus": hltb_status,
        })
    tracked_ids = {g["id"] for g in watched}

    games.sort(key=lambda g: (-g["weekMinutes"], -g["lastPlayed"]))
    record["games"] = games
    stores = []
    for g in games:
        if g["store"] not in stores:
            stores.append(g["store"])
    record["stores"] = stores
    record["weekMinutes"] = sum(g["weekMinutes"] for g in games)
    record["days"] = merge_day_series(steam_days, sessions_day_series(now, {k: v for k, v in spans_by_id.items() if k in tracked_ids}))
    if record["weekSource"] == "none" and any(g["store"] != "Steam" for g in games):
        record["weekSource"] = "sessions"
    # Steam missing is only an error when there is nothing else to show.
    if errors and not games and not watched:
        record["error"] = errors[0]
    write_json_atomic(RECORD_PATH, record)
    if not args.no_hltb and not args.no_hltb_spawn and any(g["hltbStatus"] != "override" for g in games):
        spawn_hltb()
    return 0


if __name__ == "__main__":
    sys.exit(main())
